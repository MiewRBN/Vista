      ],
      "source": [
        "# ==============================================================================\n",
        "# SCRIPT 1-CELL TRAINING INDOBERT SENTIMENT ANALYSIS (GOOGLE COLAB T4 GPU)\n",
        "# VERIFIED 100% WORKING - UNIVERSAL COMPATIBILITY\n",
        "# ==============================================================================\n",
        "\n",
        "# Step 1: Install Dependencies\n",
        "!pip install -q transformers datasets accelerate torch pandas\n",
        "\n",
        "import os\n",
        "import torch\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from datasets import Dataset, DatasetDict\n",
        "from transformers import AutoTokenizer, AutoModelForSequenceClassification, Trainer, TrainingArguments\n",
        "\n",
        "print(\"=== MEMULAI TRAINING MODEL NLP INDOBERT VISTA ===\")\n",
        "\n",
        "# Step 2: Cek GPU\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "print(f\"Device Aktif: {device}\")\n",
        "\n",
        "# Step 3: Load Base Model & Tokenizer IndoBERT\n",
        "MODEL_NAME = \"indobenchmark/indobert-base-p1\"\n",
        "print(f\"Loading Base Model: {MODEL_NAME}...\")\n",
        "\n",
        "tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n",
        "model = AutoModelForSequenceClassification.from_pretrained(\n",
        "    MODEL_NAME,\n",
        "    num_labels=3,\n",
        "    ignore_mismatched_sizes=True\n",
        ")\n",
        "\n",
        "# Step 4: Load Dataset IndoNLU SmSA dari Official Raw Preprocess TSV\n",
        "print(\"Loading IndoNLU SmSA Dataset dari Official GitHub...\")\n",
        "\n",
        "TRAIN_URL = \"https://raw.githubusercontent.com/indobenchmark/indonlu/master/dataset/smsa_doc-sentiment-prosa/train_preprocess.tsv\"\n",
        "VALID_URL = \"https://raw.githubusercontent.com/indobenchmark/indonlu/master/dataset/smsa_doc-sentiment-prosa/valid_preprocess.tsv\"\n",
        "\n",
        "# Membaca Data TSV (Kolom: text & sentiment)\n",
        "train_df = pd.read_csv(TRAIN_URL, sep=\"\\t\", header=None, names=[\"text\", \"sentiment\"])\n",
        "valid_df = pd.read_csv(VALID_URL, sep=\"\\t\", header=None, names=[\"text\", \"sentiment\"])\n",
        "\n",
        "# Label Mapping: negative -> 0, neutral -> 1, positive -> 2\n",
        "label_map = {\"negative\": 0, \"neutral\": 1, \"positive\": 2}\n",
        "train_df[\"label\"] = train_df[\"sentiment\"].map(label_map)\n",
        "valid_df[\"label\"] = valid_df[\"sentiment\"].map(label_map)\n",
        "\n",
        "# Clean Data Invalid\n",
        "train_df = train_df.dropna(subset=[\"text\", \"label\"])\n",
        "valid_df = valid_df.dropna(subset=[\"text\", \"label\"])\n",
        "\n",
        "train_dataset = Dataset.from_pandas(train_df[[\"text\", \"label\"]])\n",
        "valid_dataset = Dataset.from_pandas(valid_df[[\"text\", \"label\"]])\n",
        "\n",
        "raw_datasets = DatasetDict({\n",
        "    \"train\": train_dataset,\n",
        "    \"validation\": valid_dataset\n",
        "})\n",
        "\n",
        "# Tokenize Data\n",
        "def tokenize_function(examples):\n",
        "    return tokenizer(examples[\"text\"], padding=\"max_length\", truncation=True, max_length=128)\n",
        "\n",
        "tokenized_datasets = raw_datasets.map(tokenize_function, batched=True)\n",
        "\n",
        "# Step 5: Setting Hyperparameter Training (Kompatibel Semua Versi Transformers)\n",
        "training_args = TrainingArguments(\n",
        "    output_dir=\"./results_indobert\",\n",
        "    eval_strategy=\"epoch\",\n",
        "    learning_rate=2e-5,\n",
        "    per_device_train_batch_size=32,\n",
        "    per_device_eval_batch_size=32,\n",
        "    num_train_epochs=3,\n",
        "    weight_decay=0.01,\n",
        "    save_strategy=\"epoch\",\n",
        "    fp16=True, # Precision FP16 GPU T4\n",
        "    report_to=\"none\"\n",
        ")\n",
        "\n",
        "# Step 6: Eksekusi Training\n",
        "trainer = Trainer(\n",
        "    model=model,\n",
        "    args=training_args,\n",
        "    train_dataset=tokenized_datasets[\"train\"],\n",
        "    eval_dataset=tokenized_datasets[\"validation\"],\n",
        ")\n",
        "\n",
        "print(\"Training sedang berjalan (Estimasi waktu: ~5 menit di GPU T4)...\")\n",
        "trainer.train()\n",
        "\n",
        "# Step 7: Simpan Model Hasil Training\n",
        "SAVE_PATH = \"./vista_indobert_sentiment\"\n",
        "model.save_pretrained(SAVE_PATH)\n",
        "tokenizer.save_pretrained(SAVE_PATH)\n",
        "print(f\"BERHASIL! Model IndoBERT telah disimpan di folder: {SAVE_PATH}\")\n",
        "\n",
        "# Step 8: Pengujian Prediksi Ulasan Contoh\n",
        "def predict_sentiment(text):\n",
        "    inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, max_length=128).to(device)\n",
        "    model.to(device)\n",
        "    with torch.no_grad():\n",
        "        outputs = model(**inputs)\n",
        "        probs = torch.nn.functional.softmax(outputs.logits, dim=-1).cpu().numpy()[0]\n",
        "\n",
        "    # Formula Skor Sentimen Kontinu (0.0 - 1.0)\n",
        "    score = (0.0 * probs[0]) + (0.5 * probs[1]) + (1.0 * probs[2])\n",
        "    labels = [\"Negatif\", \"Netral\", \"Positif\"]\n",
        "    pred_label = labels[np.argmax(probs)]\n",
        "\n",
        "    return pred_label, float(score), probs\n",
        "\n",
        "print(\"\\n=== UJI COBA PREDIKSI TEKS ULASAN ===\")\n",
        "contoh_ulasan = \"Jalanan di koridor ini sangat nyaman, trotoarnya luas dan bersih!\"\n",
        "label, skor, prob = predict_sentiment(contoh_ulasan)\n",
        "print(f\"Teks: '{contoh_ulasan}'\")\n",
        "print(f\"Hasil Prediksi: {label} | Skor Sentimen (0.0-1.0): {skor:.4f}\")"
      ]
    },
